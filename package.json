{
  "name": "iitm-qualifier-hub",
  "version": "0.1.0",
  "private": true,
  "description": "SEO-first, data-driven study platform for IIT Madras BS qualifier-stage students.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:link": "dotenv -e .env.local -- sh -c 'supabase link --project-ref \"$SUPABASE_PROJECT_REF\"'",
    "db:push": "dotenv -e .env.local -- supabase db push",
    "db:seed": "dotenv -e .env.local -- node scripts/db-seed.mjs",
    "db:types": "dotenv -e .env.local -- sh -c 'supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > src/lib/supabase/database.types.ts'"
  },
  "dependencies": {
    "@shikijs/rehype": "4.4.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hast-util-to-string": "3.0.1",
    "isbot": "5.2.2",
    "katex": "0.18.7",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "shiki": "4.4.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "mdast-util-mdx-jsx": "3.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.0.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.1"
  }
}
