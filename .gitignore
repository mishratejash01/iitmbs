# ── Secrets ──────────────────────────────────────────────────────────────
# Every env file is ignored except the documented template.
.env
.env.*
!.env.example
*.pem
*.key

# ── Dependencies ─────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js / build output ───────────────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── Testing ──────────────────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.lighthouseci/

# ── Supabase local state ─────────────────────────────────────────────────
supabase/.branches
supabase/.temp
supabase/.env

# ── Platform ─────────────────────────────────────────────────────────────
.vercel
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editors ──────────────────────────────────────────────────────────────
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
