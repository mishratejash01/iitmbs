# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — copy to `.env.local` and fill in. Never commit real
# values. Every variable is validated at startup by `src/env.ts` (Zod).
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put a secret
# in one of those.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute origin of the deployed site, no trailing slash. Used for canonical
# URLs, sitemaps, Open Graph URLs and auth redirects.
# e.g. https://qualifierhub.in  (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key: the publishable key (sb_publishable_…) or the legacy anon
# JWT. Row Level Security is what protects data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY privileged key: the secret key (sb_secret_…) or the legacy
# service_role JWT. Bypasses RLS. Used only by the analytics ingest, download
# counter and account-deletion code paths. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for the Supabase CLI / Management API (migrations, type
# generation). Not read by the running app. Create at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Supabase project ref used by the CLI scripts in package.json.
SUPABASE_PROJECT_REF=

# ── Cloudinary (optional — uploads and tracked downloads degrade gracefully) ──
# Cloud name is public (used to build image delivery URLs).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# API key + secret: SERVER-ONLY, used to sign admin uploads and time-limited
# download URLs.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that admin uploads are placed in, e.g. qualifier-hub
CLOUDINARY_UPLOAD_FOLDER=

# ── Revalidation & search-engine pings ───────────────────────────────────────
# Shared secret for POST /api/revalidate (Supabase database webhook + admin
# tooling). Long random string: `openssl rand -hex 32`.
REVALIDATE_SECRET=
# IndexNow key (8–128 chars, [a-zA-Z0-9-]). Served at /indexnow-key.txt and
# sent to IndexNow (Bing, Yandex, Seznam, Naver) when content is published.
# Leave empty to disable pings.
INDEXNOW_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
# Secret mixed into the daily-rotating HMAC used to hash client IPs for rate
# limiting and unique counts. Raw IPs are never stored. `openssl rand -hex 32`.
ANALYTICS_HASH_SECRET=
